# Only reviewed project folders and root source files enter local history.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/src/
!/tests/
!/tools/
!/build/
!/requirements-*.txt
!/setup_*.ps1
!/.claude/
/.claude/*
!/.claude/settings.json

# Personal data and runtime directories, including nested copies.
personal_data/
.personal_data-transfers/
data/
backups/
exports/
local-llm/
local-tts/
local-stt/
local-agent/
self-update/
versions/
maintenance/
tools/vendor/

# Credentials, private recordings/logs and generated local results.
*.dpapi
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*
*.bak
*.jsonl
*.log
*.pid
.tmp-*
*.wav
*.mp3
*.mp4

# Python caches, local environments and compiled installers.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
build/dist/
build/work/
dist/
*.spec
*.exe
*.dll
*.zip
